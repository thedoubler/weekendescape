{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekendescape",
  "main": "worker-entry.js", // thin https-redirect shell around .open-next/worker.js
  "compatibility_date": "2026-08-28",
  // OpenNext's server bundle uses Node APIs; without these two the Worker
  // fails at runtime rather than at build time.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // "none", because the default html_handling 307s any *.html URL to its
    // extensionless twin — which broke Google's site-verification file
    // (their checker needs a 200 at the EXACT .html URL, and got a redirect
    // into a 404). No page on this site is reached via an .html path, so
    // exact-match serving costs nothing.
    "html_handling": "none"
  },
  // Per-IP rate limiting, counted at the edge before a request costs anything.
  // Two tiers because the routes are not equally expensive: a weekend search is
  // a paid Kiwi query, while autocomplete and weather are cheap and fire several
  // times per interaction. Periods may only be 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Shared cache for upstream API responses — NOT bound yet, on purpose.
  //
  // The in-memory tier in src/lib/api-cache.ts is per-isolate and dies on cold
  // start, so on Workers it catches far less than it appears to locally, and
  // every miss is a paid Kiwi call. KV fixes that. To turn it on:
  //
  //   npx wrangler kv namespace create API_CACHE
  //
  // then paste the returned id and uncomment (done 2026-09-03 — namespace
  // created against the account, id below is real):
  "kv_namespaces": [
    { "binding": "API_CACHE", "id": "531bb78e499840b1b50d5e018a7aae2f" }
  ],
  //
  // It ships commented out because a placeholder id is not inert: wrangler
  // validates namespace ids at deploy time and refuses the whole deploy with
  // "KV namespace 'REPLACE_WITH_NAMESPACE_ID' is not valid". A config that
  // blocks deploys until someone runs a command is worse than no config. The
  // code already treats an absent binding as an absent tier, so nothing breaks
  // while this is off.
  // The canary (canary.js, driven by scheduled() in worker-entry.js). Every
  // 30 minutes, because nothing about this product gets acted on faster than
  // that; the cost argument for a slower cadence was weaker than it looked
  // (the "paid Kiwi call" premise above is repo lore, not a confirmed tier —
  // see docs/seo-origin-pages.md on the partner agreement).
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  // Outbound alert mail, via the zone's own Email Routing — no third-party
  // provider and no API key. destination_address pins it to the ONE verified
  // address on the account; Cloudflare refuses to send anywhere else, which
  // is also why this binding cannot be used to mail users.
  "send_email": [
    {
      "name": "ALERT_EMAIL",
      "destination_address": "raulropan@gmail.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
